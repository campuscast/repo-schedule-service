NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# Auth
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
AUDIT_SERVICE_URL=http://localhost:3009

# Database
DATABASE_URL=postgresql://campuscast:campuscast@localhost:5432/schedule_db
DB_MIGRATIONS_RUN=true
DB_SYNCHRONIZE=false

# Redis
REDIS_URL=redis://localhost:6379

# CRDT
CRDT_COMPACTION_THRESHOLD=100
CRDT_GLOBAL_ENABLED=true

# Downstream services
ZONE_SERVICE_URL=http://localhost:3002
CONTENT_SERVICE_URL=http://localhost:3004
DEVICE_SERVICE_URL=http://localhost:3003
VALIDATION_QA_URL=http://localhost:3007
SIGNING_KMS_URL=http://localhost:3008
SYNC_SERVICE_URL=http://localhost:3006
CORS_ORIGIN=http://localhost:3000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_PORT=9464

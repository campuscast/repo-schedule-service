{
  "name": "@campuscast/schedule-service",
  "version": "0.1.0",
  "description": "Schedule Service — CRUD, versioning, locking/CRDT strategy, publish",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=/property/",
    "lint": "eslint 'src/**/*.ts'",
    "migrate": "typeorm-ts-node-commonjs migration:run -d ./data-source.ts",
    "migrate:revert": "typeorm-ts-node-commonjs migration:revert -d ./data-source.ts",
    "migrate:generate": "typeorm-ts-node-commonjs migration:generate -d ./data-source.ts",
    "test:property": "jest --runInBand --testPathPattern=property"
  },
  "dependencies": {
    "@campuscast/shared-libs": "file:../repo-shared-libs",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.0",
    "typeorm": "^0.3.20",
    "pg": "^8.13.0",
    "ioredis": "^5.4.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "rxjs": "^7.8.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/express": "^4.17.0",
    "typescript": "^5.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint": "^9.0.0",
    "ts-node": "^10.9.0",
    "fast-check": "^3.22.0",
    "@types/jest": "^29.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
